# Copy to .env (same folder as app.py) and fill in real values. Never commit the real .env.

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB_NAME=SchizoEye

# --- Dashboard logins (a role with no password set is disabled) ---
ADMIN_PASSWORD=
DOCTOR_PASSWORD=
CLINICIAN_PASSWORD=

# --- Flask ---
SECRET_KEY=
PORT=5000

# --- CORS: extra allowed origins beyond the built-in defaults, comma-separated ---
# e.g. http://localhost:5173 for the Vite dev server
CORS_ORIGINS=
